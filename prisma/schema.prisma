generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User: Represents registered students and campus administrators at IIIT-NR.
model User {
  id               String         @id @default(cuid())
  studentId        String         @unique
  name             String
  email            String         @unique
  passwordHash     String
  branch           String
  year             String
  avatarUrl        String         @default("")
  rating           Float          @default(5.0)
  reliabilityScore Float          @default(100.0)
  role             String         @default("STUDENT")
  isSuspended      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items                Item[]
  lentTransactions     Transaction[]  @relation("OwnerTransactions")
  borrowedTransactions Transaction[]  @relation("BorrowerTransactions")
  ratingsGiven         Rating[]       @relation("ReviewerRatings")
  ratingsReceived      Rating[]       @relation("RevieweeRatings")
  notifications        Notification[]
  sentMessages         Message[]      @relation("SentMessages")
  receivedMessages     Message[]      @relation("ReceivedMessages")
  raisedDisputes       Dispute[]      @relation("RaisedDisputes")
}

// Item: Represents equipment, books, and gadgets listed for peer borrowing or rental.
model Item {
  id              String        @id @default(cuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  category        String
  description     String
  imageUrl        String
  condition       String
  mode            String        @default("BORROW")
  rentalPrice     Float?
  declaredValue   Float         @default(1000.0)
  securityDeposit Float?
  maxDuration     Int           @default(7)
  availability    String        @default("AVAILABLE")
  campusLocation  String        @default("Hostel Raman")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions    Transaction[]
}

// Transaction: Represents the complete peer-to-peer exchange lifecycle of an item.
model Transaction {
  id               String        @id @default(cuid())
  itemId           String
  item             Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User          @relation("OwnerTransactions", fields: [ownerId], references: [id], onDelete: Cascade)
  borrowerId       String
  borrower         User          @relation("BorrowerTransactions", fields: [borrowerId], references: [id], onDelete: Cascade)
  requestDate      DateTime      @default(now())
  approvalDate     DateTime?
  startDate        DateTime?
  deadline         DateTime
  actualReturnDate DateTime?
  mode             String        @default("BORROW")
  status           String        @default("REQUESTED")
  overdueDays      Int           @default(0)
  penalty          Float         @default(0.0)
  penaltyRate      Float         @default(0.05)
  maxPenaltyCap    Float         @default(0.50)
  ratingChange     Float         @default(0.0)
  borrowerNotes    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  ratings          Rating[]
  messages         Message[]
  disputes         Dispute[]
}

// Rating: Post-return peer feedback given by borrower to lender or lender to borrower.
model Rating {
  id            String       @id @default(cuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User         @relation("ReviewerRatings", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId    String
  reviewee      User         @relation("RevieweeRatings", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String
  criteria      String?
  createdAt     DateTime     @default(now())
}

// Notification: Real-time campus alert dispatches.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  link      String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

// Message: Real-time private chat messages exchanged between lender and borrower.
model Message {
  id            String       @id @default(cuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime     @default(now())
}

// Dispute: Escalation filed when an item is damaged, lost, or not returned.
model Dispute {
  id              String       @id @default(cuid())
  transactionId   String
  transaction     Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  raisedById      String
  raisedBy        User         @relation("RaisedDisputes", fields: [raisedById], references: [id], onDelete: Cascade)
  reason          String
  status          String       @default("OPEN")
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?
}

// PlatformConfig: Global settings for penalty rates and time-travel simulation.
model PlatformConfig {
  id                       String   @id @default("global")
  penaltyRateDaily         Float    @default(0.05)
  penaltyMaxPercent        Float    @default(0.50)
  simulatedTimeOffsetHours Int      @default(0)
  updatedAt                DateTime @updatedAt
}
